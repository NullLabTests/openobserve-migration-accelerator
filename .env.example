# ============================================================================
# OpenObserve Migration Accelerator - local demo configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` before running `docker compose up`:
#
#     cp .env.example .env
#
# The defaults below are LOCAL-ONLY demo credentials. They are intentionally
# public and must NEVER be used outside your laptop.
# ============================================================================

# --- OpenObserve root account (local demo only) -----------------------------
# Change these for anything beyond a throwaway local POC.
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123

# --- OpenObserve OTLP auth header -------------------------------------------
# HTTP Basic header = "Basic " + base64("<email>:<password>").
# Regenerate it whenever you change the credentials above, e.g.:
#   printf '%s' "$ZO_ROOT_USER_EMAIL:$ZO_ROOT_USER_PASSWORD" | base64
# Default below matches the default credentials:
#   base64("root@example.com:Complexpass#123")
OPENOBSERVE_AUTH=Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=

# --- Demo / collector tuning -------------------------------------------------
# How many requests/second the built-in load generator fires at the demo app.
LOADGEN_RPS=20
# Log verbosity for the demo app: debug | info | warn | error
LOG_LEVEL=info
