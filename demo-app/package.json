{
  "name": "openobserve-migration-demo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Instrumented two-service Node.js demo that emits OTLP logs, metrics and traces for the OpenObserve Migration Accelerator.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:checkout": "SERVICE_ROLE=checkout OTEL_SERVICE_NAME=checkout-api PORT=8080 node src/index.js",
    "start:orders": "SERVICE_ROLE=orders OTEL_SERVICE_NAME=orders-api PORT=8081 node src/index.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "express": "^5.0.0"
  }
}
